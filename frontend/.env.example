# Core API/media configuration
VITE_API_URL=http://127.0.0.1:8000/api
VITE_MEDIA_URL=http://127.0.0.1:8000

# Optional. If omitted, the WebSocket origin is derived from VITE_API_URL.
VITE_WEBSOCKET_URL=ws://127.0.0.1:8000

# Local/preview mode only. Production pakhlai.com hostnames take precedence.
VITE_APP_MODE=customer
